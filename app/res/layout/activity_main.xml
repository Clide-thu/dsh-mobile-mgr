<?xml version="1.0" encoding="utf-8"?>
<!-- v0.2.0 layout contract: root is a vertical LinearLayout (never an overlay
     FrameLayout), custom top bar is the first child, content has height=0dp +
     weight=1, and the root carries fitsSystemWindows as a declarative hint.
     UiInsets adds the runtime inset padding (status bar -> top bar paddingTop,
     navigation/IME -> content paddingBottom). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_app_bar" />

    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/host_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingLeft="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingRight="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_l"
            android:scrollbars="vertical" />

        <ScrollView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/empty_hosts"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/empty_import_ssh"
                    style="@style/PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:minWidth="200dp"
                    android:text="@string/import_ssh_config" />

                <Button
                    android:id="@+id/empty_add_host"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:minWidth="200dp"
                    android:text="@string/add_host" />

                <Button
                    android:id="@+id/empty_ssh_keys"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:minWidth="200dp"
                    android:text="@string/empty_ssh_keys_entry" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
